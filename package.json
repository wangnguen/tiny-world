{
  "name": "desktop-pet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:desktop": "pnpm --filter desktop tauri dev",
    "build:desktop": "pnpm --filter desktop tauri build",
    "icons:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:sprites && pnpm test:overlay && pnpm -r test",
    "test:sprites": "node --test scripts/prepare-sprites.test.mjs && node scripts/prepare-sprites.mjs --check && node scripts/prepare-items.mjs --check",
    "test:overlay": "node --test scripts/interaction.test.mjs scripts/crown.test.mjs scripts/chat.test.mjs"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
